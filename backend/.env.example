# Conexion usada por la app. Dentro de docker-compose el host es "postgres".
# Corriendo la app fuera de Docker, usa localhost:5432.
DATABASE_URL=postgresql+psycopg://broker:broker@localhost:5432/broker

# Base separada para los tests (servicio postgres-test, puerto 5433 hacia afuera).
TEST_DATABASE_URL=postgresql+psycopg://broker:broker@localhost:5433/broker_test

APP_NAME=Property Broker Settlement
DEBUG=true
